---
// /about/philosophy/ — Phase 7 per docs/roadmap.md. "We don't just
// create fighters. We forge warriors." is supplied in master-prompt.md
// §4 as the brand's existing philosophy statement — used here per that
// section's explicit instruction to develop it carefully, with
// violence NOT the primary message (§4), built around the 7 warrior
// traits master-prompt.md §4 names.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AboutNav from '../../components/AboutNav.astro';
import Button from '../../components/Button.astro';
import { withBase } from '../../lib/base';

const traits = [
  { title: 'Discipline', description: 'Showing up, doing the work, and building habits that hold under pressure.' },
  { title: 'Courage', description: 'Stepping onto the mat, trying the technique, taking the class you\'re nervous about.' },
  { title: 'Confidence', description: 'Earned through progress you can feel — not given, built session by session.' },
  { title: 'Respect', description: 'For your training partners, your coaches, and yourself.' },
  { title: 'Resilience', description: 'Getting back up — on the mat and everywhere else.' },
  { title: 'Focus', description: 'The ability to be fully present, one round, one rep, one class at a time.' },
  { title: 'Continuous Improvement', description: 'There\'s always a next level. Training never really "finishes."' },
];
---

<BaseLayout
  title="Our Philosophy — Warriors Den MMA"
  description={`"We don't just create fighters. We forge warriors." What that means at Warriors Den MMA — discipline, courage, confidence, respect, resilience, focus, and continuous improvement.`}
>
  <section class="page-header">
    <Container>
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Philosophy' }]} />
      <SectionHeading eyebrow="About Warriors Den" title="Our Philosophy" />
      <AboutNav active="philosophy" />
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="philosophy-intro">
        <p class="text-display-l philosophy-intro__statement">
          "We don't just create fighters.<br />We forge warriors."
        </p>
        <p class="text-body-lg text-muted">
          At Warriors Den, "warrior" isn't about aggression. It's about what training builds in you
          over time — on the mat and off it.
        </p>
      </div>
    </Container>
  </section>

  <section class="section section--surface">
    <Container>
      <SectionHeading eyebrow="What a warrior means to us" title="Seven traits we train for" align="center" />
      <div class="traits-grid">
        {
          traits.map((trait, i) => (
            <article class="trait">
              <span class="trait__index text-index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="trait__title">{trait.title}</h3>
              <p class="text-small text-muted">{trait.description}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="final-cta">
    <Container>
      <div class="final-cta__inner">
        <p class="text-micro final-cta__kicker">Ready when you are</p>
        <h2 class="text-display-m final-cta__title">Ready to start?</h2>
        <Button href={withBase('/free-trial/')} variant="primary" arrow>Book a Free Trial</Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-16) var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }
  .page-header :global(.breadcrumbs) {
    margin-bottom: var(--space-8);
  }
  .page-header :global(.about-nav) {
    margin-top: var(--space-8);
  }

  .section {
    padding-block: var(--space-16);
  }
  .section--surface {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .philosophy-intro {
    max-width: 60ch;
  }
  .philosophy-intro__statement {
    color: var(--color-text-strong);
    margin-bottom: var(--space-8);
  }
  .philosophy-intro :global(.text-body-lg) {
    max-width: 52ch;
  }

  .traits-grid {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: var(--space-12);
    border: 1px solid var(--color-border);
  }
  .trait {
    padding: var(--space-8) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .trait__index {
    display: block;
    font-size: 1.75rem;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .trait__title {
    font-family: var(--font-body);
    font-size: var(--fs-ui-heading);
    font-weight: 700;
    color: var(--color-text-strong);
    margin-bottom: var(--space-2);
  }

  .final-cta {
    background: var(--color-bg-sunken);
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-20);
  }
  .final-cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .final-cta__kicker {
    color: var(--color-accent-text);
  }
  .final-cta__title {
    color: var(--color-text-strong);
  }
  .final-cta :global(.btn) {
    margin-top: var(--space-4);
  }

  @media (min-width: 600px) {
    .traits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .trait {
      border-right: 1px solid var(--color-border);
    }
    /* last column has no right border */
    .trait:nth-child(2n) {
      border-right: 0;
    }
  }
  @media (min-width: 1024px) {
    .traits-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .trait:nth-child(2n) {
      border-right: 1px solid var(--color-border);
    }
    .trait:nth-child(3n) {
      border-right: 0;
    }
  }
</style>
