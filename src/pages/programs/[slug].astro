---
// /programs/[slug]/ — one page per confirmed program. Phase 5 per
// docs/roadmap.md. Static paths generated from data/programs.ts, so
// adding a program to that file is enough to get a new page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import { programs, type Program } from '../../../data/programs';
import { withBase } from '../../lib/base';

export function getStaticPaths() {
  return programs.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

interface Props {
  program: Program;
}

const { program } = Astro.props;

const otherPrograms = programs.filter((p) => p.id !== program.id);
---

<BaseLayout
  title={`${program.name} Training — Warriors Den MMA, Kolkata`}
  description={program.shortDescription}
>
  <section class="page-header">
    <Container>
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Programs', href: '/programs/' },
          { label: program.name },
        ]}
      />
      <Badge tone="primary" class="page-header__badge">{program.audience}</Badge>
      <h1 class="text-display-l page-header__title">{program.name}</h1>
      <p class="text-body-lg text-muted page-header__lede">{program.shortDescription}</p>
      <div class="page-header__actions">
        <Button href={withBase(`/free-trial/?program=${program.id}`)} variant="primary">
          Book a Free Trial
        </Button>
        <Button href={withBase('/#locations')} variant="outline">View Locations</Button>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="content-grid">
        <div class="content-grid__main">
          <h2 class="text-h2">About {program.name}</h2>
          {program.overview.map((paragraph) => <p class="text-body">{paragraph}</p>)}
        </div>

        <aside class="content-grid__aside">
          <p class="text-micro content-grid__aside-label">What you'll build</p>
          <ul class="benefits-list">
            {program.benefits.map((benefit) => <li class="text-small">{benefit}</li>)}
          </ul>
          <Button href={withBase(`/free-trial/?program=${program.id}`)} variant="primary" class="aside-cta">
            Try {program.name}
          </Button>
        </aside>
      </div>
    </Container>
  </section>

  <section class="section section--surface">
    <Container>
      <h2 class="text-h2">Explore other programs</h2>
      <div class="other-programs">
        {
          otherPrograms.map((p, i) => (
            <a href={withBase(`/programs/${p.slug}/`)} class="other-programs__link">
              <span class="other-programs__index text-micro">{String(i + 1).padStart(2, '0')}</span>
              <span class="other-programs__row">
                <span class="other-programs__name">{p.name}</span>
                <span class="other-programs__arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }
  .page-header :global(.breadcrumbs) {
    margin-bottom: var(--space-6);
  }
  .page-header__badge {
    margin-bottom: var(--space-4);
  }
  .page-header__title {
    color: var(--color-text-strong);
  }
  .page-header__lede {
    margin-top: var(--space-5);
    max-width: 56ch;
  }
  .page-header__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .section {
    padding-block: var(--space-16);
  }
  .section--surface {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  .content-grid__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 68ch;
  }

  .content-grid__aside {
    align-self: start;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .content-grid__aside-label {
    color: var(--color-accent-text);
  }
  .benefits-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-6);
    color: var(--color-text-muted);
  }
  .benefits-list li {
    padding-left: var(--space-4);
    position: relative;
  }
  .benefits-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 1px;
    background: var(--color-accent);
  }
  .content-grid__aside :global(.aside-cta) {
    width: 100%;
  }

  .other-programs {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .other-programs__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-base) var(--ease-out);
  }
  @media (hover: hover) {
    .other-programs__link:hover {
      border-color: var(--color-accent);
      transform: translateY(-3px);
    }
  }
  .other-programs__index {
    color: var(--color-accent);
  }
  .other-programs__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .other-programs__name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-strong);
  }
  .other-programs__arrow {
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
    }
    .other-programs {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
