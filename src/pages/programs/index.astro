---
// /programs/ — overview. Phase 5 per docs/roadmap.md.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import { programs } from '../../../data/programs';
---

<BaseLayout
  title="Martial Arts Programs — Warriors Den MMA, Kolkata"
  description="Explore MMA, Boxing, Kickboxing, Muay Thai, Jiu-Jitsu, and Judo training at Warriors Den MMA in Kolkata. Book a free trial class today."
>
  <section class="page-header">
    <Container>
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Programs' }]} />
      <SectionHeading
        eyebrow="Programs"
        title="Train in what moves you"
        description="Six disciplines, one training philosophy: build real skill, safely and progressively."
      />
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="programs-grid">
        {programs.map((program, i) => <ProgramCard program={program} index={i + 1} />)}
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-16) var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }
  .page-header :global(.breadcrumbs) {
    margin-bottom: var(--space-8);
  }
  .section {
    padding-block: var(--space-16) var(--space-24);
  }
  .programs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 600px) {
    .programs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .programs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
