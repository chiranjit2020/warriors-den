---
// /locations/[slug]/ — one page per confirmed location. Phase 6 per
// docs/roadmap.md. Per master-prompt.md §19, each page must have
// genuinely unique content, not a templated city-name swap — the
// areaNote, address, and (where present) real Google rating differ per
// branch. Per-branch program availability is NOT confirmed (see
// data/programs.ts), so all 6 programs are listed with an honest
// disclaimer rather than asserting a specific, unverified subset.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import { locations, type Location } from '../../../data/locations';
import { programs } from '../../../data/programs';
import { localBusinessSchema } from '../../lib/schema';
import { withBase, stripBase } from '../../lib/base';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const otherLocations = locations.filter((l) => l.id !== location.id);
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.mapsQuery)}`;
// stripBase: schema.org URL represents the eventual real domain, not
// this deployment's staging subpath (see src/lib/base.ts).
const pageUrl = new URL(stripBase(Astro.url.pathname), Astro.site).toString();
---

<BaseLayout
  title={`${location.name} — Warriors Den MMA, Kolkata`}
  description={`${location.areaNote} Book a free trial class at Warriors Den MMA's ${location.name} branch.`}
  schema={[localBusinessSchema(location, pageUrl)]}
>
  <section class="page-header">
    <Container>
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Locations', href: '/locations/' },
          { label: location.name },
        ]}
      />
      {
        location.googleRating && (
          <Badge tone="primary" class="page-header__badge">
            {location.googleRating.toFixed(1)}★ · {location.googleReviewCount} Google reviews
          </Badge>
        )
      }
      <h1 class="text-display-l page-header__title">{location.name}</h1>
      <p class="text-body-lg text-muted page-header__note">{location.areaNote}</p>
      <p class="text-small text-muted page-header__address">{location.address}</p>

      <div class="page-header__actions">
        {location.phone && (
          <Button href={`tel:${location.phone.replace(/\s+/g, '')}`} variant="ghost">
            <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M6.6 2.5 4 5.1c-.5.5-.7 1.3-.4 2 1.2 3.4 3.4 6.5 6.3 9s6.1 4.4 9.6 5.4c.7.2 1.5 0 2-.5l2.5-2.6c.5-.5.4-1.4-.2-1.8l-3.7-2.4c-.5-.3-1.1-.3-1.5.1l-1.5 1.3c-2-1-3.7-2.7-4.8-4.7l1.3-1.6c.3-.4.4-1 .1-1.5L8.6 2.7c-.4-.6-1.3-.7-1.9-.2Z"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
              />
            </svg>
            Call {location.phone}
          </Button>
        )}
        <Button href={mapsHref} variant="outline">Get Directions</Button>
        <Button href={withBase(`/free-trial/?location=${location.id}`)} variant="primary">Book Free Trial</Button>
      </div>
    </Container>
  </section>

  <section class="section section--surface">
    <Container>
      <h2 class="text-h2">Programs at this branch</h2>
      <p class="text-small text-muted">
        We haven't confirmed exact per-branch program availability yet — ask us when you book
        your trial. Here's everything we teach across Warriors Den MMA:
      </p>
      <div class="programs-row">
        {
          programs.map((program) => (
            <a href={withBase(`/programs/${program.slug}/`)} class="programs-row__link text-small">
              {program.name}
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  {
    otherLocations.length > 0 && (
      <section class="section">
        <Container>
          <h2 class="text-h2">Other locations</h2>
          <div class="other-locations">
            {otherLocations.map((l) => (
              <a href={withBase(`/locations/${l.slug}/`)} class="other-locations__card">
                <h3 class="other-locations__name">{l.name}</h3>
                <p class="text-small text-muted">{l.areaNote}</p>
                <span class="text-micro other-locations__cta">View branch &rarr;</span>
              </a>
            ))}
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }
  .page-header :global(.breadcrumbs) {
    margin-bottom: var(--space-6);
  }
  .page-header__badge {
    margin-bottom: var(--space-4);
  }
  .page-header__title {
    color: var(--color-text-strong);
  }
  .page-header__note {
    margin-top: var(--space-5);
    max-width: 56ch;
  }
  .page-header__address {
    margin-top: var(--space-3);
    max-width: 50ch;
  }
  .page-header__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .section {
    padding-block: var(--space-16);
  }
  .section--surface {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .programs-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .programs-row__link {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }
  .programs-row__link:hover {
    border-color: var(--color-accent);
    color: var(--color-text-strong);
  }

  .other-locations {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .other-locations__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-out);
  }
  @media (hover: hover) {
    .other-locations__card:hover {
      border-color: var(--color-accent);
      transform: translateY(-3px);
    }
  }
  .other-locations__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-strong);
  }
  .other-locations__cta {
    margin-top: var(--space-2);
    color: var(--color-accent-text);
  }

  @media (min-width: 600px) {
    .other-locations {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
