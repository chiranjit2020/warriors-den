---
// /free-trial/ — Phase 9 per docs/roadmap.md (built out fully now; was a
// thin wrapper since Phase 4, just enough to keep CTA links working).
// Reuses the same TrialForm the homepage embeds — no duplicated form
// logic. Trust bullets are generic/safe (no fabricated claims); the
// location list reuses real, already-published data.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrialForm from '../components/TrialForm.astro';
import { locations } from '../../data/locations';
import { withBase } from '../lib/base';

const trustPoints = [
  'No experience needed — classes welcome complete beginners',
  'No pressure, no obligation to continue',
  'Meet the coaches and see the training space for yourself',
];
---

<BaseLayout
  title="Book a Free Trial — Warriors Den MMA"
  description="Book your free trial class at Warriors Den MMA in Kolkata. Fill in your details and our team will confirm your session."
>
  <section class="page-header">
    <Container>
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Free Trial' }]} />
      <SectionHeading
        eyebrow="Get Started"
        title="Book Your Free Trial"
        description="Fill in your details and our team will confirm your trial class — no experience or equipment needed."
      />
      <ul class="trust-list">
        {trustPoints.map((point) => <li class="text-small">{point}</li>)}
      </ul>
    </Container>
  </section>

  <section class="section">
    <Container>
      <div class="layout">
        <div class="layout__form">
          <TrialForm />
        </div>

        <aside class="layout__aside">
          <p class="text-micro layout__aside-label">Our locations</p>
          <ul class="location-list">
            {
              locations.map((location) => (
                <li>
                  <a href={withBase(`/locations/${location.slug}/`)} class="location-list__link">
                    {location.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="text-small text-muted">
            Not sure which branch? Leave it blank in the form and we'll help you pick.
          </p>
        </aside>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-16) var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }
  .page-header :global(.breadcrumbs) {
    margin-bottom: var(--space-8);
  }

  .trust-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-8);
    max-width: 52ch;
  }
  .trust-list li {
    padding-left: var(--space-6);
    position: relative;
    color: var(--color-text-muted);
  }
  .trust-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-success);
    font-weight: 700;
  }

  .section {
    padding-block: var(--space-16) var(--space-24);
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
  }
  .layout__aside {
    align-self: start;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .layout__aside-label {
    color: var(--color-accent-text);
  }

  .location-list {
    display: flex;
    flex-direction: column;
    margin: var(--space-4) 0 var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .location-list li {
    border-bottom: 1px solid var(--color-border);
  }
  .location-list__link {
    display: block;
    padding: var(--space-3) 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-strong);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .location-list__link:hover {
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
