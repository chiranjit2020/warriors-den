---
// BaseLayout — shared shell: fonts, tokens/base CSS, meta/SEO, Header,
// Footer, Toast, the atmosphere canvas + grain overlay. docs/architecture.md §4.
//
// Fonts are self-hosted, static per-weight files (NOT variable fonts):
//   - Manrope: WebKit fails to resolve the variable font's weight axis
//     (font-weight computes as 800 but renders a lighter static instance);
//     static @font-face per weight has no axis to mis-resolve.
//   - Bebas Neue: ships a single weight (400) anyway.
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '@fontsource/bebas-neue/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import Atmosphere from '../components/Atmosphere.astro';
import { organizationSchema } from '../lib/schema';
import { withBase, stripBase } from '../lib/base';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (LocalBusiness, Person, FAQPage,
   * etc.) — Organization is already included on every page below. */
  schema?: Record<string, unknown>[];
}

const { title, description, canonical, noindex = false, schema = [] } = Astro.props;
// stripBase: canonical/OG URLs represent the eventual real domain, not
// this deployment's staging subpath — see src/lib/base.ts.
const canonicalURL = canonical ?? new URL(stripBase(Astro.url.pathname), Astro.site).toString();
const siteUrl = Astro.site?.toString() ?? '/';
const allSchema = [organizationSchema(siteUrl), ...schema];
---

<!doctype html>
<html lang="en" data-theme="dark" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111517" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    {/* No-flash: apply the stored theme + drop .no-js before first paint. */}
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.remove('no-js');
        try {
          var t = localStorage.getItem('wd-theme');
          r.setAttribute('data-theme', t === 'light' ? 'light' : 'dark');
        } catch (e) {
          r.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {
      allSchema.map((entry) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
      ))
    }
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <Atmosphere />
    <div class="grain-overlay" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Toast />

    <script>
      // Scroll-reveal: reveal [data-reveal] elements as they enter view.
      // reduced-motion / no-JS are handled in base.css (always visible).
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const showAll = () => els.forEach((el) => el.classList.add('is-visible'));

      if (els.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '200px 0px', threshold: 0.01 },
        );
        els.forEach((el) => io.observe(el));
        // Safety net: never leave content hidden if the observer is
        // starved (background tab on load, odd embed contexts, etc.).
        setTimeout(showAll, 2500);
      } else {
        showAll();
      }
    </script>
  </body>
</html>
