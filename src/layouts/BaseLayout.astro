---
// BaseLayout — shared shell: tokens/base CSS, meta/SEO slot, Header, Footer,
// Toast region. Every real page (built from Phase 4 onward) wraps this.
// docs/architecture.md §4.
import '@fontsource-variable/manrope';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import { organizationSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (LocalBusiness, Person, FAQPage,
   * etc.) — Organization is already included on every page below. */
  schema?: Record<string, unknown>[];
}

const { title, description, canonical, noindex = false, schema = [] } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString() ?? '/';
const allSchema = [organizationSchema(siteUrl), ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {
      allSchema.map((entry) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
      ))
    }
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Toast />
  </body>
</html>
