---
// FAQItem — built on native <details>/<summary>: keyboard-operable and
// screen-reader-friendly with zero JS. docs/design-system.md.
interface Props {
  question: string;
  class?: string;
}

const { question, class: className } = Astro.props;
---

<details class:list={['faq-item', className]}>
  <summary class="faq-item__question">
    <span class="text-h4">{question}</span>
    <svg class="faq-item__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 2v12M2 8h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </summary>
  <div class="text-body text-muted faq-item__answer">
    <slot />
  </div>
</details>

<style>
  .faq-item {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-5);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none;
    color: var(--color-text-strong);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .faq-item__question::-webkit-details-marker {
    display: none;
  }
  .faq-item__question:hover {
    color: var(--color-accent);
  }

  .faq-item__icon {
    flex-shrink: 0;
    color: var(--color-accent);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .faq-item[open] .faq-item__icon {
    transform: rotate(135deg);
  }

  .faq-item__answer {
    padding-top: var(--space-3);
    max-width: 62ch;
  }
</style>
