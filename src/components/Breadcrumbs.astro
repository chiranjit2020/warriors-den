---
// Breadcrumbs — semantic nav for sub-pages, paired with a matching
// JSON-LD BreadcrumbList (docs/architecture.md §4, master-prompt.md §18)
// built from the exact same `items` array the visible nav renders, so
// the structured data can never drift from what's actually on the page.
interface Crumb {
  label: string;
  href?: string; // omit on the current page
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const currentPageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: item.href ? new URL(item.href, Astro.site).toString() : currentPageUrl,
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbList)} />

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol class="breadcrumbs__list">
    {
      items.map((item, i) => (
        <li class="breadcrumbs__item">
          {item.href ? (
            <a href={item.href} class="text-small">
              {item.label}
            </a>
          ) : (
            <span class="text-small" aria-current="page">
              {item.label}
            </span>
          )}
          {i < items.length - 1 && (
            <span class="breadcrumbs__sep" aria-hidden="true">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .breadcrumbs__item a {
    color: var(--color-text-muted);
  }
  .breadcrumbs__item a:hover {
    color: var(--color-primary-hover);
  }
  .breadcrumbs__item span[aria-current] {
    color: var(--color-text);
    font-weight: 600;
  }
  .breadcrumbs__sep {
    color: var(--color-border);
  }
</style>
