---
// Modal — accessible dialog built on the native <dialog> element, which
// gives us focus trapping, Escape-to-close, and top-layer stacking for
// free. docs/design-system.md §14, master-prompt.md §23 (keyboard/focus).
//
// This component renders only the dialog, not a trigger — put
// data-modal-open={id} directly on whatever real trigger element you use
// (e.g. <Button data-modal-open={id}>Open</Button>). Wrapping a <Button>
// (a real <button>) in a trigger element of our own would nest two
// interactive elements, which is invalid HTML and silently breaks click
// handling in the browser.
interface Props {
  id: string;
  titleId?: string;
  class?: string;
}

const { id, titleId = `${id}-title`, class: className } = Astro.props;
---

<dialog id={id} class:list={['modal', className]} aria-labelledby={titleId}>
  <div class="modal__panel">
    <button type="button" class="modal__close" data-modal-close aria-label="Close dialog">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path
          d="M2 2l14 14M16 2L2 16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
    <slot />
  </div>
</dialog>

<style>
  .modal {
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevated);
    max-width: min(560px, calc(100vw - var(--space-8)));
    width: 100%;
  }

  .modal::backdrop {
    background: rgba(20, 23, 47, 0.6);
  }

  .modal__panel {
    position: relative;
    padding: var(--space-8);
    background: var(--color-background);
  }

  .modal__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-secondary);
    cursor: pointer;
  }
  .modal__close:hover {
    background: var(--color-border);
  }
</style>

<script>
  // Event delegation so this works for any number of Modal instances;
  // Astro dedupes identical inline scripts across component instances.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const opener = target.closest<HTMLElement>('[data-modal-open]');
    if (opener) {
      const id = opener.dataset.modalOpen;
      const dialog = id && document.getElementById(id);
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    const closer = target.closest<HTMLElement>('[data-modal-close]');
    if (closer) {
      closer.closest('dialog')?.close();
      return;
    }

    // Click on the backdrop (the <dialog> element itself, outside .modal__panel) closes it.
    if (target instanceof HTMLDialogElement && target.matches('.modal')) {
      target.close();
    }
  });
</script>
