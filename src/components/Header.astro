---
// Header — site nav + primary CTA + mobile hamburger + sticky mobile CTA
// bar. docs/design-system.md §14, master-prompt.md §33.
import Container from './Container.astro';
import Button from './Button.astro';
import MobileMenu from './MobileMenu.astro';

// Structural nav, not business data — matches docs/information-architecture.md.
const navItems = [
  { label: 'About', href: '/about/' },
  { label: 'Programs', href: '/programs/' },
  { label: 'Locations', href: '/locations/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Contact', href: '/contact/' },
];

const ctaHref = '/free-trial/';
const ctaLabel = 'Book Free Trial';
---

<div class="announcement-bar">
  <Container>
    <p class="text-caption announcement-bar__text">
      Training now open across 3 Kolkata locations — Bablatala · Kestopur · Madhyamgram
    </p>
  </Container>
</div>

<header class="site-header">
  <Container class="site-header__bar">
    <a href="/" class="site-header__logo text-h3">Warriors Den <span>MMA</span></a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a class="site-header__nav-link text-body" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={ctaHref} variant="primary" class="site-header__cta">{ctaLabel}</Button>
      <button
        type="button"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="wd-mobile-menu"
        aria-label="Open menu"
      >
        <svg class="icon-open" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path
            d="M2 5h18M2 11h18M2 17h18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M3 3l16 16M19 3L3 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>

    <MobileMenu items={navItems} ctaHref={ctaHref} ctaLabel={ctaLabel} />
  </Container>
</header>

<div class="sticky-mobile-cta">
  <Button href={ctaHref} variant="primary" class="sticky-mobile-cta__btn">{ctaLabel}</Button>
</div>

<style>
  .announcement-bar {
    background: var(--color-secondary);
  }
  .announcement-bar__text {
    color: var(--color-text-inverse-muted);
    text-align: center;
    padding-block: var(--space-2);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .site-header__logo {
    color: var(--color-secondary);
    white-space: nowrap;
  }
  .site-header__logo span {
    /* text-h3, bold — large text, so primary-hover's 3.28:1 clears the 3:1
       threshold here; see design-system.md §1 for why smaller text can't. */
    color: var(--color-primary-hover);
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav-list {
    display: flex;
    gap: var(--space-6);
  }

  .site-header__nav-link {
    color: var(--color-text);
    font-weight: 500;
  }
  .site-header__nav-link:hover {
    color: var(--color-primary-strong); /* hover state — primary-hover fails 4.5:1, see design-system.md §1 */
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__cta {
    display: none;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-secondary);
    cursor: pointer;
  }
  .site-header__toggle:hover {
    background: var(--color-surface);
  }
  .site-header__toggle .icon-close {
    display: none;
  }
  .site-header__toggle[aria-expanded='true'] .icon-open {
    display: none;
  }
  .site-header__toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  .sticky-mobile-cta {
    position: fixed;
    z-index: 40;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-3) var(--gutter-mobile);
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    box-shadow: var(--shadow-elevated);
  }

  .sticky-mobile-cta :global(.sticky-mobile-cta__btn) {
    width: 100%;
  }

  @media (min-width: 900px) {
    .site-header__nav {
      display: block;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .site-header__toggle {
      display: none;
    }
    .sticky-mobile-cta {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const menu = document.getElementById('wd-mobile-menu');

  function closeMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    menu.hidden = true;
  }

  function openMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    menu.hidden = false;
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 900) closeMenu();
  });
</script>
