---
// Header — site nav + primary CTA + theme toggle + mobile hamburger +
// sticky mobile CTA bar. docs/design-system.md §"Navigation".
import Container from './Container.astro';
import Button from './Button.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';
import { withBase } from '../lib/base';

// Structural nav, not business data — matches docs/information-architecture.md.
const navItems = [
  { label: 'About', href: withBase('/about/') },
  { label: 'Programs', href: withBase('/programs/') },
  { label: 'Locations', href: withBase('/locations/') },
  { label: 'Gallery', href: withBase('/gallery/') },
  { label: 'Reviews', href: withBase('/reviews/') },
  { label: 'Contact', href: withBase('/contact/') },
];

const ctaHref = withBase('/free-trial/');
const ctaLabel = 'Book Free Trial';
---

<div class="announcement-bar">
  <Container>
    <p class="text-micro announcement-bar__text">
      <span class="announcement-bar__dot" aria-hidden="true"></span>
      Now training across 3 Kolkata locations — Bablatala · Kestopur · Madhyamgram
    </p>
  </Container>
</div>

<header class="site-header" data-scrolled="false">
  <Container>
    <div class="site-header__bar">
    <a href={withBase('/')} class="site-header__logo">Warriors Den <span>MMA</span></a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a class="site-header__nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeToggle class="site-header__theme" />
      <Button href={ctaHref} variant="primary" class="site-header__cta">{ctaLabel}</Button>
      <button
        type="button"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="wd-mobile-menu"
        aria-label="Open menu"
      >
        <svg class="icon-open" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M2 5h18M2 11h18M2 17h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M3 3l16 16M19 3L3 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <MobileMenu items={navItems} ctaHref={ctaHref} ctaLabel={ctaLabel} />
    </div>
  </Container>
</header>

<div class="sticky-mobile-cta">
  <Button href={ctaHref} variant="primary" class="sticky-mobile-cta__btn" arrow>{ctaLabel}</Button>
</div>

<style>
  .announcement-bar {
    background: var(--color-bg-sunken);
    border-bottom: 1px solid var(--color-border);
  }
  .announcement-bar__text {
    color: var(--color-text-muted);
    text-align: center;
    letter-spacing: 0.08em;
    padding-block: var(--space-2);
  }
  .announcement-bar__dot {
    display: none;
  }
  @media (min-width: 720px) {
    .announcement-bar__text {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
    }
    .announcement-bar__dot {
      display: block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-accent);
      flex-shrink: 0;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }
  .site-header[data-scrolled='true'] {
    background: color-mix(in srgb, var(--color-bg) 95%, transparent);
    border-bottom-color: var(--color-border);
  }

  .site-header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .site-header__logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-strong);
    white-space: nowrap;
    transform: translateY(0.05em);
  }
  .site-header__logo span {
    color: var(--color-accent);
  }

  .site-header__nav {
    display: none;
  }
  .site-header__nav-list {
    display: flex;
    gap: var(--space-6);
  }
  .site-header__nav-link {
    position: relative;
    font-size: var(--fs-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text);
    padding-block: var(--space-2);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .site-header__nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transition: right var(--duration-base) var(--ease-out);
  }
  .site-header__nav-link:hover {
    color: var(--color-text-strong);
  }
  .site-header__nav-link:hover::after {
    right: 0;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .site-header__cta {
    display: none;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-strong);
    cursor: pointer;
  }
  .site-header__toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .site-header__toggle .icon-close {
    display: none;
  }
  .site-header__toggle[aria-expanded='true'] .icon-open {
    display: none;
  }
  .site-header__toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  .sticky-mobile-cta {
    position: fixed;
    z-index: 40;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-3) var(--gutter-mobile);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border);
  }
  .sticky-mobile-cta :global(.sticky-mobile-cta__btn) {
    width: 100%;
  }

  @media (min-width: 900px) {
    .site-header__nav {
      display: block;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .site-header__toggle {
      display: none;
    }
    .sticky-mobile-cta {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const menu = document.getElementById('wd-mobile-menu');

  const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 8));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function closeMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    menu.hidden = true;
  }
  function openMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    menu.hidden = false;
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 900) closeMenu();
  });
</script>
