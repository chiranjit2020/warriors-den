---
// Stats — a row of stat tiles. Large Bebas numerals as visual anchors,
// Manrope for the supporting label. Only render real/confirmed figures —
// never a fabricated number. docs/design-system.md §"Numbers & statistics".
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  class?: string;
}

const { stats, class: className } = Astro.props;
---

<dl class:list={['stats', className]}>
  {
    stats.map((stat) => (
      <div class="stats__item">
        <dt class="stats__value">{stat.value}</dt>
        <dd class="stats__label text-micro">{stat.label}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 0;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-4);
    background: var(--color-bg);
  }

  .stats__value {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    font-size: clamp(2.25rem, 8vw, 4.5rem);
    color: var(--color-text-strong);
    overflow-wrap: break-word;
  }

  .stats__label {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (min-width: 480px) {
    .stats__item {
      padding: var(--space-6);
    }
  }

  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
