---
// ContactForm — general inquiry form, distinct from TrialForm (which is
// specifically for booking a trial class). docs/design-system.md §8,
// master-prompt.md §31. Same stubbed-submission status as TrialForm —
// see docs/architecture.md §7.1 (owner-confirmed decision, 2026-09-05).
import Button from './Button.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['contact-form-wrap', className]}>
  <form id="contact-form" class="contact-form" novalidate>
    <label class="contact-form__field">
      <span class="text-small contact-form__label">Full Name <span aria-hidden="true">*</span></span>
      <input type="text" name="fullName" required autocomplete="name" />
      <span class="text-caption contact-form__error" data-error-for="fullName"></span>
    </label>

    <div class="contact-form__row">
      <label class="contact-form__field">
        <span class="text-small contact-form__label">Email</span>
        <input type="email" name="email" autocomplete="email" />
        <span class="text-caption contact-form__error" data-error-for="email"></span>
      </label>

      <label class="contact-form__field">
        <span class="text-small contact-form__label">Phone</span>
        <input type="tel" name="phone" autocomplete="tel" inputmode="tel" />
      </label>
    </div>
    <p class="text-caption contact-form__hint" data-error-for="contactMethod">
      Please provide at least one of email or phone so we can reach you.
    </p>

    <label class="contact-form__field">
      <span class="text-small contact-form__label">Message <span aria-hidden="true">*</span></span>
      <textarea name="message" rows="4" required></textarea>
      <span class="text-caption contact-form__error" data-error-for="message"></span>
    </label>

    <div class="contact-form__banner contact-form__banner--error" data-form-error hidden role="alert">
      Please fix the highlighted fields and try again.
    </div>

    <Button type="submit" variant="primary" class="contact-form__submit">
      <span class="contact-form__submit-label">Send Message</span>
    </Button>
  </form>

  <div class="contact-form__success" data-form-success hidden role="status">
    <h3 class="text-h3">Message sent 👊</h3>
    <p class="text-body text-muted">
      Thanks for reaching out — our team will get back to you shortly.
    </p>
  </div>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successEl = document.querySelector<HTMLElement>('[data-form-success]');
  const errorBanner = document.querySelector<HTMLElement>('[data-form-error]');

  function setFieldError(name: string, message: string) {
    const field = form?.elements.namedItem(name) as HTMLElement | null;
    field?.setAttribute('aria-invalid', 'true');
    const errorEl = form?.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (errorEl) errorEl.textContent = message;
  }

  function clearErrors() {
    form?.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    form?.querySelectorAll('[data-error-for="fullName"], [data-error-for="email"], [data-error-for="message"]')
      .forEach((el) => (el.textContent = ''));
    form?.querySelector('[data-error-for="contactMethod"]')?.removeAttribute('data-active');
    errorBanner?.setAttribute('hidden', '');
  }

  function validate(data: FormData): boolean {
    let valid = true;
    const fullName = String(data.get('fullName') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const phone = String(data.get('phone') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    if (!fullName) {
      setFieldError('fullName', 'Please enter your name.');
      valid = false;
    }
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setFieldError('email', 'Please enter a valid email address.');
      valid = false;
    }
    if (!email && !phone) {
      form?.querySelector('[data-error-for="contactMethod"]')?.setAttribute('data-active', 'true');
      valid = false;
    }
    if (!message) {
      setFieldError('message', 'Please enter a message.');
      valid = false;
    }
    return valid;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearErrors();

    const data = new FormData(form);
    if (!validate(data)) {
      errorBanner?.removeAttribute('hidden');
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('.contact-form__submit');
    submitBtn?.setAttribute('aria-busy', 'true');
    submitBtn?.setAttribute('disabled', 'true');

    try {
      // TODO: wire real submission — see docs/architecture.md §7.1 (staying
      // stubbed for now, owner-confirmed).
      await new Promise((resolve) => setTimeout(resolve, 900));

      form.hidden = true;
      successEl?.removeAttribute('hidden');
      successEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      window.wdToast?.show("Message sent — we'll be in touch shortly!", 'success');
    } catch {
      errorBanner?.removeAttribute('hidden');
      window.wdToast?.show('Something went wrong. Please try again.', 'error');
    } finally {
      submitBtn?.removeAttribute('aria-busy');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-form[hidden] {
    display: none;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-form__label {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }
  .contact-form__label span[aria-hidden] {
    color: var(--color-accent);
  }

  .contact-form input,
  .contact-form textarea {
    font: inherit;
    font-size: var(--text-body-size);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text);
    min-height: 46px;
  }
  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: var(--color-text-muted);
  }
  .contact-form textarea {
    min-height: 110px;
    resize: vertical;
  }
  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .contact-form__hint {
    color: var(--color-text-muted);
    margin-top: calc(-1 * var(--space-2));
  }
  .contact-form__hint[data-active='true'] {
    color: var(--color-error);
  }

  .contact-form__error {
    color: var(--color-error);
    min-height: 1em;
  }
  .contact-form [aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .contact-form__banner {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
  }
  .contact-form__banner--error {
    background: var(--color-error-surface);
    color: var(--color-error);
    border: 1px solid color-mix(in srgb, var(--color-error) 40%, transparent);
  }

  .contact-form :global(.contact-form__submit) {
    align-self: flex-start;
    min-width: 200px;
  }
  .contact-form :global(.contact-form__submit[aria-busy='true']) {
    position: relative;
    color: transparent;
    pointer-events: none;
  }
  .contact-form :global(.contact-form__submit[aria-busy='true']::after) {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--color-primary-text);
    border-top-color: transparent;
    animation: contact-form-spin var(--duration-slow) linear infinite;
  }
  @keyframes contact-form-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (min-width: 600px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
