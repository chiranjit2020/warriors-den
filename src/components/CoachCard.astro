---
// CoachCard — docs/design-system.md §"Cards". No fabricated bio/photo —
// shows a clearly-labeled placeholder when those fields aren't supplied.
// Renders its own surface (rather than composing <Card>) so all of its
// styling is in this component's scope.
import type { Coach } from '../../data/coaches';

interface Props {
  coach: Coach;
}

const { coach } = Astro.props;
const initials = coach.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<article class="coach-card">
  <div class="coach-card__avatar" aria-hidden="true">
    {coach.photo ? <img src={coach.photo} alt="" /> : <span>{initials}</span>}
  </div>
  <h3 class="coach-card__name">{coach.name}</h3>
  <p class="text-micro coach-card__role">{coach.role}</p>
  <p class="text-small text-muted coach-card__bio">{coach.bio ?? 'Full bio coming soon'}</p>
</article>

<style>
  .coach-card {
    text-align: center;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .coach-card__avatar {
    width: 72px;
    height: 72px;
    margin: 0 auto var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.03em;
    overflow: hidden;
  }
  .coach-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .coach-card__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-strong);
  }
  .coach-card__role {
    margin-top: var(--space-2);
    color: var(--color-accent-text);
  }
  .coach-card__bio {
    margin-top: var(--space-3);
  }
</style>
