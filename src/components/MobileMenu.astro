---
// MobileMenu — collapsible nav panel for small viewports, opened by the
// hamburger button in Header.astro. docs/design-system.md §"Navigation".
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items: NavItem[];
  ctaHref: string;
  ctaLabel: string;
}

const { items, ctaHref, ctaLabel } = Astro.props;
---

<nav id="wd-mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
  <ul class="mobile-menu__list">
    {
      items.map((item, i) => (
        <li>
          <a class="mobile-menu__link" href={item.href}>
            <span class="mobile-menu__index">{String(i + 1).padStart(2, '0')}</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <a class="mobile-menu__cta" href={ctaHref}>{ctaLabel} <span aria-hidden="true">&rarr;</span></a>
</nav>

<style>
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-elevated);
    padding: var(--space-5) var(--gutter-mobile) var(--space-8);
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-5);
  }
  .mobile-menu__list li + li {
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-strong);
  }
  .mobile-menu__link:hover {
    color: var(--color-accent);
  }
  .mobile-menu__index {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-micro);
    color: var(--color-text-muted);
  }

  .mobile-menu__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 52px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-size: 1.375rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (min-width: 900px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
