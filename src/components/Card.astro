---
// Card — shared structured-content surface. ProgramCard / CoachCard /
// LocationCard / etc. compose this. docs/design-system.md §"Cards".
// Architectural, not decorative: hairline border, near-square, minimal
// elevation, deliberate red interaction state.
interface Props {
  as?: keyof HTMLElementTagNameMap;
  dark?: boolean;
  interactive?: boolean; // hover movement + accent edge (desktop only)
  class?: string;
  href?: string;
  [key: `data-${string}`]: string | undefined;
}

const { as: Tag = 'div', dark = false, interactive = false, class: className, ...rest } = Astro.props;
---

<Tag
  class:list={['card', dark && 'card--dark', interactive && 'card--interactive', className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .card--dark {
    background: var(--color-surface-dark);
    border-color: var(--color-border-dark);
    color: var(--color-text-inverse);
  }

  @media (hover: hover) {
    .card--interactive {
      transition:
        border-color var(--duration-base) var(--ease-standard),
        transform var(--duration-base) var(--ease-out);
    }
    .card--interactive::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--color-accent);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform var(--duration-base) var(--ease-out);
    }
    .card--interactive:hover {
      border-color: var(--color-border-strong);
      transform: translateY(-4px);
    }
    .card--interactive:hover::before {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card--interactive:hover {
      transform: none;
    }
  }
</style>
