---
// AboutNav — sub-nav shared across the 3 /about/* pages.
import { withBase } from '../lib/base';

interface Props {
  active: 'story' | 'philosophy' | 'coaches';
}

const { active } = Astro.props;
const items = [
  { id: 'story', label: 'Our Story', href: '/about/' },
  { id: 'philosophy', label: 'Our Philosophy', href: '/about/philosophy/' },
  { id: 'coaches', label: 'Coaches', href: '/about/coaches/' },
] as const;
---

<nav class="about-nav" aria-label="About">
  <ul class="about-nav__list">
    {
      items.map((item) => (
        <li>
          <a
            href={withBase(item.href)}
            class="about-nav__link"
            aria-current={item.id === active ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .about-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .about-nav__link {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }
  .about-nav__link:hover {
    border-color: var(--color-accent);
    color: var(--color-text-strong);
  }
  .about-nav__link[aria-current='page'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
