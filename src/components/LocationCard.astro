---
// LocationCard — docs/design-system.md §"Cards". Only renders fields that
// are actually present on the Location record; TODO fields (hours,
// instructor, WhatsApp) are omitted rather than shown blank or faked.
// Renders its own surface so all styling lives in this component's scope.
import type { Location } from '../../data/locations';
import Button from './Button.astro';
import { withBase } from '../lib/base';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.mapsQuery)}`;
---

<article class="location-card">
  <h3 class="location-card__name">{location.name}</h3>
  <p class="text-small text-muted location-card__address">{location.address}</p>

  {
    location.googleRating && (
      <p class="text-micro location-card__rating">
        <strong>{location.googleRating.toFixed(1)}★</strong> · {location.googleReviewCount} Google reviews
      </p>
    )
  }

  <div class="location-card__actions">
    {location.phone && (
      <Button href={`tel:${location.phone.replace(/\s+/g, '')}`} variant="ghost">
        <svg class="location-card__phone-icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M6.6 2.5 4 5.1c-.5.5-.7 1.3-.4 2 1.2 3.4 3.4 6.5 6.3 9s6.1 4.4 9.6 5.4c.7.2 1.5 0 2-.5l2.5-2.6c.5-.5.4-1.4-.2-1.8l-3.7-2.4c-.5-.3-1.1-.3-1.5.1l-1.5 1.3c-2-1-3.7-2.7-4.8-4.7l1.3-1.6c.3-.4.4-1 .1-1.5L8.6 2.7c-.4-.6-1.3-.7-1.9-.2Z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
          />
        </svg>
        Call {location.phone}
      </Button>
    )}
    <Button href={mapsHref} variant="outline">Get Directions</Button>
    <Button href={withBase(`/free-trial/?location=${location.id}`)} variant="primary">Book Free Trial</Button>
  </div>
</article>

<style>
  .location-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .location-card__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-strong);
  }
  .location-card__address {
    max-width: 40ch;
  }
  .location-card__rating {
    color: var(--color-accent-text);
    margin-top: var(--space-1);
  }
  .location-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-5);
  }
  .location-card__actions :global(.btn) {
    min-width: 0;
  }
  .location-card__phone-icon {
    flex-shrink: 0;
  }
  /* narrow cards (single-column / small screens): buttons go full-width
     so long labels never force the card wider than its column */
  @media (max-width: 400px) {
    .location-card__actions :global(.btn) {
      flex: 1 0 100%;
    }
  }
</style>
