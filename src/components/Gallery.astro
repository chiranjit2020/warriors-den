---
// Gallery — docs/design-system.md §14, master-prompt.md §35.
// No real Warriors Den photography has been supplied yet, and the
// master prompt explicitly forbids generic stock photography standing
// in for it. These tiles are honest, clearly-labeled placeholders (a
// dashed outline + caption, not a fake photo) so the grid layout is
// proven now and real photos drop in later with no markup changes.
interface Props {
  count?: number;
  class?: string;
}

const { count = 6, class: className } = Astro.props;
const tiles = Array.from({ length: count });
---

<div class:list={['gallery', className]}>
  {
    tiles.map(() => (
      <div class="gallery__tile" role="img" aria-label="Training photo placeholder — real photography pending">
        <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 6a2 2 0 0 1 2-2h2l1.5-2h5L16 4h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <circle cx="12" cy="13" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <span class="text-caption">Photo pending</span>
      </div>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .gallery__tile {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  @media (min-width: 600px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
