---
// ThemeToggle — switches between the dark (canonical) and light themes.
// Choice persists in localStorage under 'wd-theme'; the no-flash script in
// BaseLayout.astro applies it before first paint. Dispatches a
// 'wd:themechange' event on window so the atmosphere canvas can re-tint.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  aria-label="Switch colour theme"
  title="Switch colour theme"
>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" />
    <path
      d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8L6 18M18 6l1.8-1.8"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    />
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-strong);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }
  .theme-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .theme-toggle__icon {
    position: absolute;
  }
  /* Dark theme active → offer the sun (switch to light). Light → moon. */
  :root:not([data-theme='light']) .theme-toggle__icon--moon,
  :root[data-theme='light'] .theme-toggle__icon--sun {
    display: none;
  }
</style>

<script>
  const KEY = 'wd-theme';
  const root = document.documentElement;

  function current(): 'dark' | 'light' {
    return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = current() === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* storage blocked — session-only toggle still works */
      }
      window.dispatchEvent(new CustomEvent('wd:themechange', { detail: { theme: next } }));
    });
  });
</script>
