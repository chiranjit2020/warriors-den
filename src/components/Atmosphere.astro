---
// Atmosphere — a barely-there depth field behind the whole site.
// docs/design-system.md §"Three.js". Three.js is loaded from a CDN as an
// ES module (is:inline so Astro/Vite leaves the URL import alone).
//
// Non-negotiable constraints, all enforced below:
//   - never runs under prefers-reduced-motion
//   - skipped on small screens / low-core devices (perf + mobile)
//   - paused when the tab is hidden or the canvas is scrolled away
//   - pointer-events: none, z-index: -1 — cannot touch reading, nav, CTAs
//   - low amplitude, slow, DPR capped, smoothed pointer follow
//   - re-tints on the 'wd:themechange' event
---

<canvas id="wd-atmosphere" aria-hidden="true"></canvas>

<style>
  #wd-atmosphere {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    display: block;
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }
  #wd-atmosphere.is-live {
    opacity: 1;
  }
</style>

<script is:inline type="module">
  const canvas = document.getElementById('wd-atmosphere');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const smallScreen = window.matchMedia('(max-width: 768px)').matches;
  const lowCore = (navigator.hardwareConcurrency || 8) < 4;

  if (canvas && !reduceMotion && !smallScreen && !lowCore) {
    try {
      const THREE = await import('https://cdn.jsdelivr.net/npm/three@0.160.1/build/three.module.js');

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
      camera.position.z = 26;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.setSize(window.innerWidth, window.innerHeight, false);

      // Point field in a wide, shallow slab so it reads as depth, not volume.
      const COUNT = 110;
      const positions = new Float32Array(COUNT * 3);
      for (let i = 0; i < COUNT; i++) {
        positions[i * 3 + 0] = (Math.random() - 0.5) * 72;
        positions[i * 3 + 1] = (Math.random() - 0.5) * 46;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 30;
      }
      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

      function themeColor() {
        return document.documentElement.getAttribute('data-theme') === 'light' ? 0x111517 : 0xffffff;
      }

      const material = new THREE.PointsMaterial({
        color: themeColor(),
        size: 0.07,
        transparent: true,
        opacity: 0.32,
        depthWrite: false,
      });
      const points = new THREE.Points(geometry, material);
      scene.add(points);

      // A single faint accent mote — the one deliberate red touch.
      const accent = new THREE.Points(
        (() => {
          const g = new THREE.BufferGeometry();
          g.setAttribute('position', new THREE.BufferAttribute(new Float32Array([6, -3, 8]), 3));
          return g;
        })(),
        new THREE.PointsMaterial({ color: 0xef0d33, size: 0.16, transparent: true, opacity: 0.55, depthWrite: false }),
      );
      scene.add(accent);

      const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
      window.addEventListener(
        'pointermove',
        (e) => {
          pointer.tx = (e.clientX / window.innerWidth - 0.5) * 2;
          pointer.ty = (e.clientY / window.innerHeight - 0.5) * 2;
        },
        { passive: true },
      );

      let running = true;
      let raf = 0;
      const clock = new THREE.Clock();

      function frame() {
        if (!running) return;
        raf = requestAnimationFrame(frame);
        const t = clock.getElapsedTime();

        // slow continuous drift
        points.rotation.y = t * 0.02;
        points.rotation.x = Math.sin(t * 0.05) * 0.05;
        accent.rotation.y = t * 0.02;

        // smoothed, low-amplitude pointer parallax
        pointer.x += (pointer.tx - pointer.x) * 0.03;
        pointer.y += (pointer.ty - pointer.y) * 0.03;
        camera.position.x += (pointer.x * 2.4 - camera.position.x) * 0.05;
        camera.position.y += (-pointer.y * 1.6 - camera.position.y) * 0.05;
        camera.lookAt(scene.position);

        renderer.render(scene, camera);
      }

      function start() {
        if (running) return;
        running = true;
        clock.start();
        frame();
      }
      function stop() {
        running = false;
        cancelAnimationFrame(raf);
        clock.stop();
      }

      // Pause when the tab is hidden or the page is scrolled well past the fold.
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      const io = new IntersectionObserver(
        (entries) => (entries[0].isIntersecting ? start() : stop()),
        { threshold: 0 },
      );
      io.observe(canvas);

      window.addEventListener(
        'resize',
        () => {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight, false);
        },
        { passive: true },
      );

      window.addEventListener('wd:themechange', () => {
        material.color.setHex(themeColor());
      });

      running = false;
      start();
      canvas.classList.add('is-live');
    } catch {
      /* WebGL unavailable or CDN blocked — the site is fully functional without it */
    }
  }
</script>
