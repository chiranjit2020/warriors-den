---
// Badge — small technical label. Program audience tags, trust markers, etc.
// docs/design-system.md §"Micro-label system". Square, tracked, understated.
interface Props {
  tone?: 'primary' | 'neutral' | 'success' | 'warning';
  class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 4px var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .badge--neutral {
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-strong);
  }

  .badge--primary {
    background: transparent;
    color: var(--color-accent-text);
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .badge--success {
    background: transparent;
    color: var(--color-success);
    border: 1px solid color-mix(in srgb, var(--color-success) 45%, transparent);
  }

  .badge--warning {
    background: transparent;
    color: var(--color-warning);
    border: 1px solid color-mix(in srgb, var(--color-warning) 45%, transparent);
  }
</style>
